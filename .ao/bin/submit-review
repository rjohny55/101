#!/bin/bash
# submit-review: Submit review decision (--approve or --reject 'reason')
set -euo pipefail

AO_SESSION="${AO_SESSION:-}"
AO_API_PORT="${AO_API_PORT:-3000}"
AO_API_KEY="${AO_INTERNAL_API_KEY:-}"

if [ -z "$AO_SESSION" ]; then
  echo "Error: AO_SESSION environment variable not set" >&2
  exit 1
fi

# Step 1: Signal the Orchestrator
# Pass through role-specific arguments such as --approve/--reject.
PAYLOAD="$(node -e 'const [session, ...args] = process.argv.slice(1); console.log(JSON.stringify({ sessionId: session, payload: { args: args.join(" ") } }));' "$AO_SESSION" "$@")"

# Build curl headers
CURL_HEADERS=(-H "Content-Type: application/json")
if [ -n "$AO_API_KEY" ]; then
  CURL_HEADERS+=(-H "x-api-key: $AO_API_KEY")
fi

response="$(curl -sS -w '\n%{http_code}' -X POST "http://localhost:$AO_API_PORT/api/events/review/submit"   "${CURL_HEADERS[@]}"   -d "$PAYLOAD")" || {
  echo "[ao] submit-review failed: could not reach orchestrator API" >&2
  exit 1
}

http_code="${response##*$'\n'}"
body="${response%$'\n'*}"

if [ "$http_code" -lt 200 ] || [ "$http_code" -ge 300 ] || ! printf '%s' "$body" | grep -q '"success"[[:space:]]*:[[:space:]]*true'; then
  echo "[ao] submit-review failed: HTTP $http_code" >&2
  printf '%s\n' "$body" >&2
  exit 1
fi

echo "[ao] submit-review recorded" >&2

exit 0
